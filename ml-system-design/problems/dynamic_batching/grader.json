{"slug": "dynamic_batching", "title": "A dynamic batching server", "difficulty": "medium", "summary": "Simulate max-batch and max-wait batching on one worker and return each request's latency.", "params": ["arrivals", "max_batch", "max_wait", "base_ms", "per_item_ms"], "cases": [{"name": "example", "args": {"arrivals": [0, 1, 2, 10], "max_batch": 2, "max_wait": 5, "base_ms": 3, "per_item_ms": 1}, "expected": [6, 5, 9, 9]}, {"name": "no requests", "args": {"arrivals": [], "max_batch": 4, "max_wait": 5, "base_ms": 3, "per_item_ms": 1}, "expected": []}, {"name": "a lone request waits max_wait", "args": {"arrivals": [0], "max_batch": 8, "max_wait": 10, "base_ms": 2, "per_item_ms": 1}, "expected": [13]}, {"name": "a full batch launches at once", "args": {"arrivals": [0, 0, 0], "max_batch": 3, "max_wait": 10, "base_ms": 2, "per_item_ms": 1}, "expected": [5, 5, 5]}, {"name": "max_batch 1: no waiting", "args": {"arrivals": [0, 1, 2, 3], "max_batch": 1, "max_wait": 100, "base_ms": 1, "per_item_ms": 0}, "expected": [1, 1, 1, 1]}, {"name": "max_wait 0: whatever has arrived when the worker is free", "args": {"arrivals": [0, 1, 2, 3, 4, 5], "max_batch": 4, "max_wait": 0, "base_ms": 10, "per_item_ms": 0}, "expected": [10, 19, 18, 17, 16, 25]}, {"name": "steady arrivals", "args": {"arrivals": [0, 2, 4, 6, 8, 10, 12, 14], "max_batch": 4, "max_wait": 3, "base_ms": 5, "per_item_ms": 2}}, {"name": "bursts", "args": {"arrivals": [0, 0.5, 1, 1.5, 20, 20.2, 20.4, 50], "max_batch": 3, "max_wait": 4, "base_ms": 2.5, "per_item_ms": 0.5}}, {"name": "a burst bigger than a batch queues behind a busy worker", "args": {"arrivals": [0, 1, 1, 1, 1, 1, 30], "max_batch": 2, "max_wait": 2, "base_ms": 4, "per_item_ms": 1}}]}