{"slug": "point_in_time_join", "title": "Point-in-time feature join", "difficulty": "medium", "summary": "Attach to each training event the latest feature value known before it, within a maximum age.", "params": ["events", "features", "max_age"], "cases": [{"name": "example", "args": {"events": [["u1", 10], ["u1", 25], ["u2", 5], ["u3", 7]], "features": [["u1", 20, "b"], ["u1", 3, "a"], ["u2", 5, "x"], ["u1", 25, "c"]], "max_age": 15}, "expected": ["a", "b", null, null]}, {"name": "no events", "args": {"events": [], "features": [["u1", 1, 1.0]], "max_age": 10}, "expected": []}, {"name": "no features", "args": {"events": [["u1", 5]], "features": [], "max_age": 10}, "expected": [null]}, {"name": "same second is not before", "args": {"events": [["u1", 5]], "features": [["u1", 5, 1.0]], "max_age": 10}, "expected": [null]}, {"name": "one second later", "args": {"events": [["u1", 6]], "features": [["u1", 5, 1.0]], "max_age": 10}, "expected": [1.0]}, {"name": "stale", "args": {"events": [["u1", 100]], "features": [["u1", 50, 1.0]], "max_age": 49}, "expected": [null]}, {"name": "exactly max_age is fresh", "args": {"events": [["u1", 100]], "features": [["u1", 50, 1.0]], "max_age": 50}, "expected": [1.0]}, {"name": "equal timestamps: last in input", "args": {"events": [["u1", 9]], "features": [["u1", 4, "first"], ["u1", 4, "second"], ["u1", 2, "old"]], "max_age": 100}, "expected": ["second"]}, {"name": "interleaved entities, unsorted rows", "args": {"events": [["a", 30], ["b", 30], ["a", 12], ["b", 1], ["a", 31]], "features": [["b", 0, 7], ["a", 30, 3], ["a", 10, 1], ["a", 20, 2], ["b", 29, 8]], "max_age": 100}, "expected": [2, 8, 1, 7, 3]}, {"name": "mixed", "args": {"events": [["e1", 1000], ["e2", 1000], ["e1", 1500], ["e3", 10], ["e2", 2000], ["e1", 999], ["e2", 1001]], "features": [["e1", 900, 0.5], ["e2", 1000, 0.7], ["e1", 1400, 0.9], ["e2", 100, 0.1], ["e1", 1499, 0.95], ["e3", 11, 0.3], ["e2", 1999, 0.8]], "max_age": 500}}]}