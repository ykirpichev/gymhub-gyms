{"slug": "reciprocal_rank_fusion", "title": "Reciprocal rank fusion", "difficulty": "easy", "summary": "Fuse several ranked lists into one using only ranks.", "params": ["rankings", "k", "top_n"], "cases": [{"name": "example", "args": {"rankings": [["a", "b", "c"], ["b", "c", "d"]], "k": 60, "top_n": 4}, "expected": ["b", "c", "a", "d"]}, {"name": "top_n cuts", "args": {"rankings": [["a", "b", "c"], ["b", "c", "d"]], "k": 60, "top_n": 2}, "expected": ["b", "c"]}, {"name": "no lists", "args": {"rankings": [], "k": 60, "top_n": 3}, "expected": []}, {"name": "an empty list", "args": {"rankings": [[], ["x"]], "k": 60, "top_n": 3}, "expected": ["x"]}, {"name": "equal scores: id order", "args": {"rankings": [["b", "a"], ["a", "b"]], "k": 60, "top_n": 2}, "expected": ["a", "b"]}, {"name": "one list keeps its order", "args": {"rankings": [["d1", "d2", "d3"]], "k": 1, "top_n": 5}, "expected": ["d1", "d2", "d3"]}, {"name": "small k: top ranks dominate", "args": {"rankings": [["p", "q", "r", "s"], ["s", "r", "q", "p"], ["q", "s"]], "k": 1, "top_n": 4}}, {"name": "large k: agreement dominates", "args": {"rankings": [["p", "q", "r", "s"], ["s", "r", "q", "p"], ["q", "s"]], "k": 1000, "top_n": 4}}, {"name": "three retrievers", "args": {"rankings": [["doc7", "doc2", "doc9", "doc4", "doc1"], ["doc2", "doc5", "doc7", "doc8"], ["doc9", "doc2", "doc3"]], "k": 60, "top_n": 3}}]}